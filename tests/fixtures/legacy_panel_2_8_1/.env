APP_PORT=3000
METRICS_PORT=3001
DATABASE_URL="postgresql://postgres:legacy-password@remnawave-db:5432/postgres"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=legacy-password
POSTGRES_DB=postgres
REDIS_SOCKET=/var/run/valkey/valkey.sock

FRONT_END_DOMAIN=panel.example.com
SUB_PUBLIC_DOMAIN=sub.example.com
METRICS_USER=legacy-metrics-user
METRICS_PASS=legacy-metrics-password

# Authentication values must survive the v3 migration byte-for-byte.
JWT_AUTH_SECRET='legacy-auth-secret-with-quotes'
JWT_API_TOKENS_SECRET=legacy-api-token-secret
JWT_AUTH_LIFETIME=168

SWAGGER_PATH=/docs
SCALAR_PATH=/scalar
IS_DOCS_ENABLED=false
CUSTOM_OPERATOR_SETTING=keep-this-value
